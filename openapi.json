{
  "openapi": "3.0.0",
  "info": {
    "title": "ROMSO Wikipedia Search API",
    "description": "",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.romso.com",
      "description": "production server"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "summary": "Execute a search query",
        "description": "Free, keyless Wikipedia search API returning articles in SearXNG-compatible JSON format.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The search term or query string",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "The response format, usually fixed to json",
            "required": true,
            "schema": {
              "type": "string",
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search query execution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
