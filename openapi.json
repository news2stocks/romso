{
  "openapi": "3.0.0",
  "info": {
    "title": "ROMSO Wikipedia Search API",
    "description": "Free, keyless Wikipedia search API returning articles in SearXNG-compatible JSON format.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.romso.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Execute Wikipedia search query",
        "description": "Queries Wikipedia and returns a list of matching articles with titles, URLs, and snippets.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The search term or query string (e.g., 'test')",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search query execution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "number_of_results": {
                      "type": "integer",
                      "example": 20
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "example": "https://wikipedia.org"
                          },
                          "title": {
                            "type": "string",
                            "example": "Alabama"
                          },
                          "content": {
                            "type": "string"
                          },
                          "score": {
                            "type": "number",
                            "example": 0.0
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
